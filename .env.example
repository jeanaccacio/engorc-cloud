# Copie este arquivo para ".env" e preencha com os valores reais.
# Na Railway/Render, essas variáveis são configuradas no painel do serviço,
# não precisam de arquivo .env lá (o próprio provedor injeta DATABASE_URL etc.).

DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"
JWT_SECRET="troque-isto-por-uma-string-aleatoria-longa-e-secreta"
PORT=3000
